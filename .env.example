LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
LLM_TEMPERATURE=0.1
# PostgreSQL for Docker Compose
POSTGRES_USER=postgres
POSTGRES_DB=app
# Replace in your local .env; use Latin letters and digits only
POSTGRES_PASSWORD=changeme

# Application settings
# dev - API documentation enabled; prod - documentation disabled
APP_ENV=dev

# PostgreSQL connection timeout in seconds (1-60)
DB_CONNECT_TIMEOUT=3

# Database connection
# Docker Compose generates DATABASE_URL automatically from POSTGRES_* variables.
# For local development outside Docker, use:
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/app

AI_DENY_GLOBS=.env*,*.pem,*.key,.git,secrets
# AI_EXCLUDE_DIRS=.git,.venv,venv,node_modules,__pycache__,dist,build,.pytest_cache,.ruff_cache,.chroma
AI_TOOL_TIMEOUT_S=30

AI_EXCLUDE_DIRS=.git,.venv,venv,node_modules,__pycache__,dist,build,.pytest_cache,.ruff_cache,.chroma,tests
AI_INDEX_BACKEND_GLOBS=README.md,CONTRIBUTING.md,docs/environment-schema.md,docs/adr/00*.md,main.py,config.py

AI_INDEX_DIR=../.chroma
# AI_INDEX_BACKEND_GLOBS=README.md,CONTRIBUTING.md,docs/*.md,*.py
AI_INDEX_ASSISTANT_GLOBS=README.md,docs/adr/*.md,docs/tools-spec-cycle2.md
AI_EMBED_MODEL=qwen3-embedding:0.6b
AI_EMBED_QUERY_PREFIX=
AI_EMBED_DOC_PREFIX=
AI_EMBED_TIMEOUT_S=300
AI_SEARCH_TOP_K=3
AI_SEARCH_MAX_DISTANCE=2.0
AI_BACKEND_URL=http://127.0.0.1:8000
