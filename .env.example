LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
LLM_TEMPERATURE=0.1
# PostgreSQL for Docker Compose
POSTGRES_USER=postgres
POSTGRES_DB=app
# Replace in your local .env; use Latin letters and digits only
POSTGRES_PASSWORD=changeme

# Application settings
# dev - API documentation enabled; prod - documentation disabled
APP_ENV=dev

# PostgreSQL connection timeout in seconds (1-60)
DB_CONNECT_TIMEOUT=3

# Database connection
# Docker Compose generates DATABASE_URL automatically from POSTGRES_* variables.
# For local development outside Docker, use:
# DATABASE_URL=postgresql://postgres:changeme@localhost:5432/app
